soong_namespace {
}

phony {
    name: "QssiCommonOverlay",
    required: [
        "QssiFrameworksOverlay",
        "QssiWifiOverlay",
    ] + select(soong_config_variable("qssi", "atv_or_car"), {
        true: [],
        default: ["QssiFrameworksNoCarAtvOverlay"],
    }) + select(soong_config_variable("qssi", "telephony"), {
        "none": [],
        "lte": [
            "QssiFrameworksTelephonyOverlay",
            "QssiTelephonyOverlay",
        ],
        default: [
            "QssiFrameworksTelephonyOverlay",
            "QssiFrameworksTelephony5gOverlay",
            "QssiTelephonyOverlay",
        ],
    }) + select(soong_config_variable("qssi", "wifi"), {
        "6g": [
            "QssiWifiOverlay",
            "QssiWifi6gOverlay",
        ],
        "bridged_soft_ap": [
            "QssiWifiOverlay",
            "QssiWifi6gOverlay",
            "QssiWifiBridgedOverlay",
        ],
        "multista": [
            "QssiWifiOverlay",
            "QssiWifi6gOverlay",
            "QssiWifiBridgedOverlay",
            "QssiWifiMultiStaOverlay",
        ],
        "multista_advanced": [
            "QssiWifiOverlay",
            "QssiWifi6gOverlay",
            "QssiWifiBridgedOverlay",
            "QssiWifiMultiStaOverlay",
            "QssiWifiMultiStaAdvancedOverlay",
        ],
        default: [
            "QssiWifiOverlay",
        ],
    }) + select(soong_config_variable("qssi", "wifi_generation"), {
        "11ax": [
            "QssiWifi11AxOverlay",
        ],
        "11be": [
            "QssiWifi11AxOverlay",
            "QssiWifi11BeOverlay",
        ],
    }) + select(soong_config_variable("qssi", "supports_ims"), {
        false: [],
        default: [
            "QssiFrameworksTelephonyImsOverlay",
            "QssiTelephonyImsOverlay",
        ],
    }) + select(soong_config_variable("qssi", "supports_wfd"), {
        true: ["QssiFrameworksWfdOverlay"],
        default: [],
    }),
}
