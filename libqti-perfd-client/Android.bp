soong_namespace {
}

cc_library_shared {
    name: "libqti-perfd-client",
    defaults: [
        "android.hardware.power-ndk_shared",
    ],
    srcs: ["client.cpp"],
    shared_libs: [
        "libbinder_ndk",
        "liblog",
        "libutils",
    ],
    cflags: [
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
    ],
    vendor: true,
}
